                🔥 FIRE
            </div>

        </div>


        <div
            class="task"
            onclick="completeTask(this)"
        >

            <div class="checkbox">
            </div>

            <div class="task-info">

                <div class="task-name">
                    准备好星期五的校院衣服
                </div>

                <div class="task-desc">
                    提前准备好星期五需要穿的校园服装。
                </div>

            </div>

            <div class="fire">
                🔥 FIRE
            </div>

        </div>

    </div>

</section>



<!-- =========================
     任务页
========================= -->

